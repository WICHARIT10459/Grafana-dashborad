      "title": "Current Heart Rate (BPM)",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${datasource}" },
          "query": "from(bucket: \"galaxy_watch\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"heart_rate\" and r._field == \"bpm\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
